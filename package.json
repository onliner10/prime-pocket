{
  "name": "prime-pocket",
  "private": true,
  "version": "0.1.0",
  "description": "Mobile access to Prime Agent without a hosted control plane",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:bridge": "pnpm --filter @prime-pocket/bridge dev",
    "start:bridge": "pnpm --filter @prime-pocket/bridge start",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "e2e": "pnpm --filter @prime-pocket/bridge run e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  }
}

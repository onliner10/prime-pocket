{
  "name": "Prime Pocket",
  "slug": "prime-pocket",
  "version": "0.1.0",
  "orientation": "portrait",
  "scheme": "prime-pocket",
  "userInterfaceStyle": "light",
  "newArchEnabled": true,
  "icon": "./assets/icon.png",
  "splash": {
    "image": "./assets/splash.png",
    "resizeMode": "contain",
    "backgroundColor": "#F2F2F2"
  },
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "ai.primeintellect.pocket",
    "infoPlist": {
      "NSAppTransportSecurity": {
        "NSAllowsArbitraryLoads": true,
        "NSAllowsLocalNetworking": true
      },
      "NSCameraUsageDescription": "Scan a pairing QR code from the Pocket bridge.",
      "NSPhotoLibraryUsageDescription": "Share screenshots and photos with Prime Agent."
    }
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#F2F2F2"
    },
    "package": "ai.primeintellect.pocket"
  },
  "plugins": [
    "expo-router",
    "expo-secure-store",
    [
      "expo-build-properties",
      {
        "android": {
          "usesCleartextTraffic": true
        }
      }
    ],
    [
      "expo-camera",
      {
        "cameraPermission": "Allow Prime Pocket to scan bridge pairing QR codes."
      }
    ],
    [
      "expo-image-picker",
      {
        "photosPermission": "Allow Prime Pocket to share photos with your agents."
      }
    ]
  ],
  "experiments": {
    "typedRoutes": false
  }
}
